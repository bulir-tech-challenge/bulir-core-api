# Application
PORT=3000
NODE_ENV=development

# Database (Neon PostgreSQL - Pooler)
DATABASE_URL="postgresql://username:password@ep-xxxx-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct URL for migrations (if needed)
DIRECT_URL="postgresql://username:password@ep-xxxx.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="1d"

# Rate limiting (pedidos por minuto, por IP)
THROTTLE_LIMIT=120
AUTH_THROTTLE_LIMIT=10
